# Shared, non-secret settings of this cluster (committed). Personal settings go in .env.

# Admin image, pinned and updated by Renovate. It also ships the launcher run by ./admin.sh.
PVE_ADMIN_IMAGE=ghcr.io/gciatto/proxmox-admin:1.3.9

# Short name of this cluster: admin.sh reads the API token secret of each administrator
# from ~/.config/proxmox-admin/<CLUSTER_NAME>/token.
CLUSTER_NAME=example

# Proxmox API endpoint: hostname or IP, without https:// or port.
PROXMOX_HOST=pve1.example.org
PROXMOX_PORT=8006

# Keep TLS verification on. For self-signed certificates, commit the CA bundle and use it.
PROXMOX_VALIDATE_CERTS=true
# PROXMOX_CA_BUNDLE=/workspace/config/certs/ca-bundle.pem
