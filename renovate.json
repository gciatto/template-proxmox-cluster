{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":semanticCommits"
  ],
  "dependencyDashboard": true,
  "automerge": true,
  "packageRules": [
    {
      "description": "Updates to GitHub Actions should be tagged as 'ci'",
      "matchFileNames": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "Major upgrades of the admin image or the OpenTofu provider need a human review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "prConcurrentLimit": 25,
  "prHourlyLimit": 0,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "customManagers": [
    {
      "description": "Admin image pinned in cluster.env",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)cluster\\.env$/"
      ],
      "matchStrings": [
        "PVE_ADMIN_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
