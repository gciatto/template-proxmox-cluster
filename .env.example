# Personal settings of one administrator: copy to .env (untracked).
# The API token SECRET goes into ~/.config/proxmox-admin/<CLUSTER_NAME>/token, never here.

# Proxmox API token ID (not the secret): user@realm!tokenname
PROXMOX_TOKEN_ID=alice@pve!admin-cli
PROXMOX_USER=alice@pve

# UNIX account used for SSH to the nodes (Ansible inventory and OpenTofu provider).
PROXMOX_SSH_USER=root
